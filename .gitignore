# ---- 操作系统 / 编辑器 ----
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp

# ---- Python（AI工具链/tools/spec_tool.py）----
__pycache__/
*.py[cod]
.pytest_cache/

# ---- 归档进程锁 ----
/change/.archive.lock

# ---- 归档工具生成的备份 ----
/change/**/*.bak
/spec/*.bak

# ---- 临时产物 ----
*.tmp
*.log

