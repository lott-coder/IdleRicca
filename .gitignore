!/Assets/**/*.asmdef
!/Assets/**/*.asmref
!/Assets/**/*.meta
/Assets/*
!/Assets/Editor/
!/Assets/Editor.meta
!/Assets/Scripts/
!/Assets/Scripts.meta
!/Assets/Tests/
!/Assets/Tests.meta

